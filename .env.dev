# -----------------------------------------------------------------------------
# .env.dev — Standard DEV environment (lokal + server)
# -----------------------------------------------------------------------------
# Hinweis: Diese Defaults sind für Development gedacht. Nicht in PROD verwenden.
# -----------------------------------------------------------------------------

# Postgres (docker-compose.dev.yml)
POSTGRES_USER=gtower
POSTGRES_PASSWORD=gtower_secret_2024
POSTGRES_DB=gtower

# Backend
DATABASE_URL=postgresql://gtower:gtower_secret_2024@postgres:5432/gtower
JWT_SECRET=dev_change_me_please
JWT_EXPIRES_IN=30m
CORS_ORIGINS=http://localhost:5173

# Storage (DEV: local FS im Container)
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=/data/uploads

# Frontend
# In Dev wird i.d.R. über den Vite-Proxy gearbeitet (relative /api). Daher leer lassen.
VITE_API_URL=
# Ziel für Vite proxy im Container-Netzwerk:
VITE_API_PROXY=http://backend:3000

