{
  "name": "gtower-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "test:smoke": "tsx --test tests/smoke.critical-api.test.ts",
    "test:storage": "tsx --test tests/integration.document-storage.test.ts",
    "test": "npm run test:smoke && npm run test:storage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jimp": "^0.22.12",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
